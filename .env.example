# Storywright 环境变量模板
# 复制为 .env 或直接 export / $env: 设置

# 必填：你自己的 LLM key（任何 OpenAI 兼容接口）
STORYWRIGHT_API_KEY=sk-xxxx

# 可选：接口地址与模型（默认 api.openai.com / gpt-4o-mini）
# 国产模型示例：
#   DeepSeek:  https://api.deepseek.com/v1          模型 deepseek-chat
#   智谱:      https://open.bigmodel.cn/api/paas/v4/ 模型 glm-4.5
#   通义:      https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
STORYWRIGHT_BASE_URL=https://api.deepseek.com/v1
STORYWRIGHT_MODEL=deepseek-chat

# 可选：服务端口（默认 5178）
# PORT=5178
